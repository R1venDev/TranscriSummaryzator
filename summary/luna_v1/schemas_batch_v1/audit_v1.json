{
  "$defs": {
    "ClaimCheck": {
      "additionalProperties": false,
      "properties": {
        "claim_text": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "supported",
            "contradicted",
            "unsupported",
            "needs_context",
            "uncertain"
          ],
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "claim_text",
        "verdict",
        "evidence_ids",
        "note"
      ],
      "type": "object"
    },
    "ContextRequest": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string"
        },
        "affected_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "question": {
          "type": "string"
        },
        "known_source_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "affected_ids",
        "question",
        "known_source_ids",
        "reason"
      ],
      "type": "object"
    },
    "DocumentCheck": {
      "additionalProperties": false,
      "properties": {
        "surface_id": {
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimCheck"
          },
          "type": "array"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "surface_id",
        "claims",
        "finding_ids"
      ],
      "type": "object"
    },
    "DocumentEvidence": {
      "additionalProperties": false,
      "properties": {
        "surface_id": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        }
      },
      "required": [
        "surface_id",
        "quote"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "u_id": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "u_id",
        "quote"
      ],
      "type": "object"
    },
    "Facet": {
      "additionalProperties": false,
      "properties": {
        "facet_id": {
          "type": "string"
        },
        "axis": {
          "enum": [
            "action",
            "actor",
            "recipient",
            "object",
            "scope",
            "status",
            "condition",
            "alternatives",
            "conjunction",
            "negation",
            "quantity",
            "unit",
            "time",
            "sequence",
            "parallelism",
            "causality",
            "uncertainty",
            "correction"
          ],
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "facet_id",
        "axis",
        "value",
        "evidence_ids"
      ],
      "type": "object"
    },
    "FacetCheck": {
      "additionalProperties": false,
      "properties": {
        "facet_id": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "preserved",
            "missing",
            "distorted",
            "uncertain",
            "not_applicable"
          ],
          "type": "string"
        },
        "document_evidence": {
          "items": {
            "$ref": "#/$defs/DocumentEvidence"
          },
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "facet_id",
        "verdict",
        "document_evidence",
        "note"
      ],
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "minor",
            "material",
            "critical"
          ],
          "type": "string"
        },
        "affected_surface_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "affected_unit_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "problem": {
          "type": "string"
        },
        "required_preservation": {
          "type": "string"
        },
        "proposed_resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "finding_id",
        "kind",
        "severity",
        "affected_surface_ids",
        "affected_unit_ids",
        "evidence_ids",
        "problem",
        "required_preservation",
        "proposed_resolution"
      ],
      "type": "object"
    },
    "SourceCheck": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "type": "string"
        },
        "inventory_verdict": {
          "enum": [
            "source_supported",
            "inventory_error",
            "needs_context",
            "uncertain"
          ],
          "type": "string"
        },
        "coverage": {
          "enum": [
            "full",
            "partial",
            "absent",
            "uncertain",
            "not_applicable"
          ],
          "type": "string"
        },
        "facet_checks": {
          "items": {
            "$ref": "#/$defs/FacetCheck"
          },
          "type": "array"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "unit_id",
        "inventory_verdict",
        "coverage",
        "facet_checks",
        "finding_ids"
      ],
      "type": "object"
    },
    "SourceUnit": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "statement",
            "action",
            "decision",
            "question",
            "hypothesis",
            "constraint",
            "rationale",
            "example"
          ],
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "facets": {
          "items": {
            "$ref": "#/$defs/Facet"
          },
          "type": "array"
        }
      },
      "required": [
        "unit_id",
        "kind",
        "text",
        "evidence_ids",
        "facets"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "luna_audit_v1"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "type": "array"
    },
    "source_checks": {
      "items": {
        "$ref": "#/$defs/SourceCheck"
      },
      "type": "array"
    },
    "document_checks": {
      "items": {
        "$ref": "#/$defs/DocumentCheck"
      },
      "type": "array"
    },
    "additional_units": {
      "items": {
        "$ref": "#/$defs/SourceUnit"
      },
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "type": "array"
    },
    "context_requests": {
      "items": {
        "$ref": "#/$defs/ContextRequest"
      },
      "type": "array"
    },
    "unprocessed_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "complete",
    "evidence",
    "source_checks",
    "document_checks",
    "additional_units",
    "findings",
    "context_requests",
    "unprocessed_ids"
  ],
  "type": "object"
}
