  "required": [
    "schema_version",
    "generation_id",
    "source_revision",
    "execution_status",
    "review_status",
    "source_scope_ids",
    "checked_ids",
    "unreviewed_ids",
    "accepted_bundle_ids",
    "rejected_bundle_ids",
    "unresolved_bundle_ids",
    "source_ambiguities",
    "model_disagreements",
    "technical_failures",
    "billed_cost_microusd",
    "held_cost_microusd",
    "unknown_bill_ids",
    "artifact_hashes",
    "generation_lineage"
