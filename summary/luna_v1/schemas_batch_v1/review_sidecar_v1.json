    "generation_id": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "execution_status": {
      "type": "string"
    },
    "review_status": {
      "enum": [
        "review_pending",
        "review_completed",
        "reviewed_with_uncertainties",
        "review_incomplete",
        "generation_failed"
      ],
      "type": "string"
    },
    "source_scope_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "checked_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "unreviewed_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "accepted_bundle_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "rejected_bundle_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "unresolved_bundle_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "source_ambiguities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "model_disagreements": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "technical_failures": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "billed_cost_microusd": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "held_cost_microusd": {
      "type": "integer"
    },
    "unknown_bill_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "artifact_hashes": {
      "items": {
